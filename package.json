{
  "name": "my-memos",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run --filter ./apps/memos dev",
    "dev:storybook": "vp run --filter ./packages/ui dev",
    "build": "vp run --filter ./apps/memos build",
    "d1:migrate:local": "pnpm --filter @my-memos/app exec void db migrate",
    "d1:migrate:remote": "pnpm --filter @my-memos/app exec void db migrate --remote",
    "deploy": "pnpm --filter @my-memos/app exec void deploy --platform cloudflare",
    "test": "vp run -r test",
    "check": "vp run --filter ./apps/memos prepare && vp check && vp run -r typecheck",
    "lint": "vp lint",
    "format": "vp fmt"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite-plus": "1.3.0"
  },
  "packageManager": "pnpm@12.11.2"
}
